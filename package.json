{
  "name": "grievancegrid",
  "private": true,
  "packageManager": "npm@10.0.0",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "db:generate": "turbo run db:generate --filter=@grievancegrid/database",
    "db:push": "turbo run db:push --filter=@grievancegrid/database",
    "db:migrate": "turbo run db:migrate --filter=@grievancegrid/database"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.0.0",
    "prettier": "^3.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
