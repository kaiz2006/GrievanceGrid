{
  "name": "@grievancegrid/ai-models",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "install:deps": "python -m venv venv 2>nul || echo venv already exists && .\\venv\\Scripts\\pip install -r requirements.txt",
    "dev": "docker-compose -f docker-compose.ml.yml up",
    "dev:build": "docker-compose -f docker-compose.ml.yml up --build",
    "start": "docker-compose -f docker-compose.ml.yml up -d",
    "stop": "docker-compose -f docker-compose.ml.yml down",
    "dev:llm": "cd llm/src && ..\\..\\venv\\Scripts\\python server.py",
    "dev:cv": "cd cv/src && ..\\..\\venv\\Scripts\\python server.py",
    "dev:gnn": "cd gnn/src && ..\\..\\venv\\Scripts\\python server.py"
  }
}
