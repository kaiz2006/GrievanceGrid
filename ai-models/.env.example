# Shared ML Service Environment Variables

# GPU Settings
CUDA_DEVICE=0
USE_GPU=true

# Model Paths (For models downloaded locally)
MODEL_DIR=/app/models
LLAMA_MODEL_ID=meta-llama/Meta-Llama-3-8B-Instruct
SENTENCE_TRANSFORMER_ID=all-MiniLM-L6-v2

# API Fallbacks (If local inference fails or is not supported locally)
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Service Ports (Internal Docker Network)
LLM_SERVICE_PORT=8001
CV_SERVICE_PORT=8002
GNN_SERVICE_PORT=8003
