APP_ENV=development
APP_NAME=GrievanceGrid API
APP_VERSION=1.0.0

DATABASE_URL=postgresql+asyncpg://grievances:grievances@localhost:5432/grievances
REDIS_URL=redis://localhost:6379/0
REDIS_PUBSUB_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
JWT_SECRET=change-me-in-production
LLM_API_URL=http://localhost:8001

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
SESSION_PREFIX=session
RATE_LIMIT_PREFIX=rate-limit
TEAM_LOCATION_PREFIX=team

OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_DIR=apps/api/storage
OBJECT_STORAGE_PUBLIC_BASE_URL=/storage
