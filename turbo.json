{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env"],
  "globalEnv": [
    "NODE_ENV",
    "VITE_API_BASE_URL",
    "VITE_WS_URL",
    "DATABASE_URL",
    "REDIS_URL",
    "JWT_SECRET"
  ],
  "tasks": {
    "install:deps": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "dist/**", "build/**"]
    },
    "lint": {},
    "test": {},
    "dev": {
      "cache": false,
      "persistent": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "inputs": ["src/schema.ts", "drizzle.config.ts"],
      "outputs": ["drizzle/**"]
    },
    "db:push": {
      "inputs": ["src/schema.ts", "drizzle.config.ts"]
    },

    "db:migrate": {
      "dependsOn": ["db:generate"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true
    },
    "db:empty": {
      "cache": false
    },
    "db:seed": {
      "cache": false
    },
    "db:seed:large": {
      "cache": false
    },
    "db:seed:xlarge": {
      "cache": false
    },
    "clean": {
      "cache": false
    }
  }
}

