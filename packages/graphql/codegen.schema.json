{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GraphQL Codegen Config",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "schema": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": { "type": "string" }
        }
      ]
    },
    "ignoreNoDocuments": { "type": "boolean" },
    "documents": {
      "oneOf": [
        { "type": "string" },
        {
          "type": "array",
          "items": { "type": "string" }
        }
      ]
    },
    "generates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "plugins": {
            "type": "array",
            "items": {
              "oneOf": [
                { "type": "string" },
                { "type": "object" }
              ]
            }
          },
          "config": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
