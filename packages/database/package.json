{
  "name": "@grievancegrid/database",
  "version": "1.0.0",
  "description": "Database schema and migrations for GrievanceGrid",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "install:deps": "npm install",
    "db:push": "drizzle-kit push:pg",
    "db:migrate": "drizzle-kit up:pg",
    "db:generate": "drizzle-kit generate:pg",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed.ts",
    "db:setup": "npm run db:generate && npm run db:push && npm run db:seed"
  },
  "dependencies": {
    "drizzle-orm": "^0.30.0",
    "pg": "^8.11.0",
    "postgres": "^3.4.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/pg": "^8.18.0",
    "@types/uuid": "^9.0.7",
    "drizzle-kit": "^0.20.0",
    "drizzle-orm": "^0.30.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.0"
  }
}
